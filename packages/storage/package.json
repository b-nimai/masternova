{
  "name": "@masternova/storage",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.6",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "tsup": "^8.3.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.6"
  },
  "type": "module",
  "module": "./dist/index.js"
}
