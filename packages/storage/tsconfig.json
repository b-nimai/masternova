{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Decorators must survive into the emitted JS: `StorageService` is a Nest provider.
    // `emitDecoratorMetadata` is deliberately absent — its one dependency is bound with an
    // explicit `@Inject(STORAGE_CONFIG)` token rather than by parameter type, so nothing
    // here needs design-time type metadata.
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
