{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Matches the apps that compile these sources: this package ships TypeScript, not a
    // build, so its files are emitted by whichever app imports them — and both are Nest
    // apps needing decorator metadata under CommonJS.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
