// Masternova — Prisma schema.
//
// Models are added by the module that owns them, in bounded-context blocks (CLAUDE.md §4).
// Phase 0 establishes only the identity seed; catalog, media, commerce, enrollment,
// engagement, notification and analytics models arrive with their modules in Phase 1.
//
// Schema changes go through `prisma migrate dev` — never `db push` outside local dev,
// and never hand-edit the generated client.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector backs semantic search over course and lecture text (task 1.13).
  // The compose image is already pgvector/pgvector:pg16; this is what actually
  // enables the extension rather than merely having it available.
  extensions = [vector]
}

// ─── identity ────────────────────────────────────────────────────────────────
// Owned by apps/api/src/modules/identity. Expanded in task 1.2 with refresh-token
// rotation, device sessions, email verification and password reset.

enum Role {
  LEARNER
  INSTRUCTOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  /// Null for OAuth-only accounts — those are rejected for password login.
  passwordHash  String?
  role          Role      @default(LEARNER)
  emailVerified DateTime?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  verificationTokens VerificationToken[]

  @@index([role])
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  /// A refresh token was presented twice. Either the chain leaked or someone is
  /// replaying it; both mean this session can no longer be trusted.
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN
}

/// One signed-in device. A user has many; revoking one leaves the others alone, which is
/// what makes "sign out my old laptop" possible without logging out the phone.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Best-effort device identification for the "your sessions" screen. Never used for
  /// authorization — a user agent is a client-supplied string and trivially forged.
  userAgent String?
  ip        String?

  createdAt     DateTime             @default(now())
  lastUsedAt    DateTime             @default(now())
  revokedAt     DateTime?
  revokedReason SessionRevokeReason?

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

/// One link in a session's refresh chain.
///
/// Rotation means every refresh mints a new token and marks the old one used. The chain is
/// kept rather than deleted, because a *used* token being presented again is precisely the
/// signal that something leaked — and you cannot detect the reuse of a row you deleted.
model RefreshToken {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, never the token itself. A database leak must not hand out
  /// live sessions. SHA-256 rather than argon2 on purpose: this is a 256-bit random
  /// value, so there is nothing to brute-force and a slow hash would only add latency
  /// to every refresh. Argon2 is for low-entropy secrets, which passwords are and this
  /// is not.
  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime  @default(now())
  /// Set when this token is exchanged. Non-null + presented again = reuse.
  usedAt    DateTime?

  @@index([sessionId])
  @@index([expiresAt])
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use, expiring token delivered by email.
///
/// Stored hashed for the same reason as refresh tokens: whoever reads this table must not
/// be able to take over an account with what they find.
model VerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   VerificationPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ─── platform kernel ─────────────────────────────────────────────────────────
// Owned by the outbox module (write side, apps/api) and the outbox-relay module
// (read side, apps/worker). No domain lives here — this is the mechanism every
// bounded context uses to make a state change and its effects atomic.

enum OutboxStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  DEAD
}

/// A domain event, written in the SAME transaction as the state change that caused it.
/// That is the whole point: without the shared transaction you either lose effects (commit
/// state, crash before publishing) or invent them (publish, then roll back the state).
model OutboxMessage {
  id String @id @default(cuid())

  /// Stable across relay retries, so a consumer can dedupe on it. This is what turns
  /// at-least-once delivery into exactly-once *effects*.
  eventId       String       @unique
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)

  /// Retry bookkeeping. `availableAt` is moved forward on failure for exponential
  /// backoff, so a poisonous message cannot spin the relay.
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  publishedAt DateTime?
  lastError   String?

  /// W3C traceparent, captured at write time. This is what lets one trace span
  /// `POST /checkout -> outbox relay -> email sent` across the queue boundary.
  traceparent String?
  createdAt   DateTime @default(now())

  /// Serves the relay's claim query: pending work that is due, oldest first.
  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
}

/// Consumer-side dedupe. The relay guarantees at-least-once; this table is how a
/// handler makes its own effect happen exactly once. Keyed by (event, handler) so
/// each handler decides independently — a retry that already emailed must not email
/// again, but a handler added later must still see the event.
model ProcessedEvent {
  eventId     String
  handler     String
  processedAt DateTime @default(now())

  @@id([eventId, handler])
  @@index([processedAt])
}

enum IdempotencyStatus {
  IN_FLIGHT
  COMPLETED
}

/// Replay protection for unsafe endpoints. The client sends `Idempotency-Key`; a repeat
/// with the same key returns the stored response instead of acting twice.
model IdempotencyRecord {
  id String @id @default(cuid())

  /// Scoped per caller, never global. A globally-keyed table would let one user probe
  /// another user's stored response by guessing a key.
  scope String
  key   String

  endpoint    String
  /// A repeat of the same key with a DIFFERENT body is a client bug, not a retry,
  /// and is rejected rather than silently served the first response.
  requestHash String
  status      IdempotencyStatus @default(IN_FLIGHT)
  statusCode  Int?
  response    Json?
  createdAt   DateTime          @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}
