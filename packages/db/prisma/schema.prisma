// Masternova — Prisma schema.
//
// Models are added by the module that owns them, in bounded-context blocks (CLAUDE.md §4).
// Phase 0 establishes only the identity seed; catalog, media, commerce, enrollment,
// engagement, notification and analytics models arrive with their modules in Phase 1.
//
// Schema changes go through `prisma migrate dev` — never `db push` outside local dev,
// and never hand-edit the generated client.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector backs semantic search over course and lecture text (task 1.13).
  // The compose image is already pgvector/pgvector:pg16; this is what actually
  // enables the extension rather than merely having it available.
  // pg_trgm backs the interim `title ILIKE '%q%'` search until Typesense lands
  // in task 1.13. `map:` is required because Prisma's identifier is camelCase and
  // Postgres's is not.
  extensions = [vector, pgTrgm(map: "pg_trgm")]
}

// ─── identity ────────────────────────────────────────────────────────────────
// Owned by apps/api/src/modules/identity. Expanded in task 1.2 with refresh-token
// rotation, device sessions, email verification and password reset.

enum Role {
  LEARNER
  INSTRUCTOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  /// Null for OAuth-only accounts — those are rejected for password login.
  passwordHash  String?
  role          Role      @default(LEARNER)
  emailVerified DateTime?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions                Session[]
  verificationTokens      VerificationToken[]
  notificationPreferences NotificationPreference[]
  courses                 Course[]

  @@index([role])
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  /// A refresh token was presented twice. Either the chain leaked or someone is
  /// replaying it; both mean this session can no longer be trusted.
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN
}

/// One signed-in device. A user has many; revoking one leaves the others alone, which is
/// what makes "sign out my old laptop" possible without logging out the phone.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Best-effort device identification for the "your sessions" screen. Never used for
  /// authorization — a user agent is a client-supplied string and trivially forged.
  userAgent String?
  ip        String?

  createdAt     DateTime             @default(now())
  lastUsedAt    DateTime             @default(now())
  revokedAt     DateTime?
  revokedReason SessionRevokeReason?

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

/// One link in a session's refresh chain.
///
/// Rotation means every refresh mints a new token and marks the old one used. The chain is
/// kept rather than deleted, because a *used* token being presented again is precisely the
/// signal that something leaked — and you cannot detect the reuse of a row you deleted.
model RefreshToken {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, never the token itself. A database leak must not hand out
  /// live sessions. SHA-256 rather than argon2 on purpose: this is a 256-bit random
  /// value, so there is nothing to brute-force and a slow hash would only add latency
  /// to every refresh. Argon2 is for low-entropy secrets, which passwords are and this
  /// is not.
  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime  @default(now())
  /// Set when this token is exchanged. Non-null + presented again = reuse.
  usedAt    DateTime?

  @@index([sessionId])
  @@index([expiresAt])
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use, expiring token delivered by email.
///
/// Stored hashed for the same reason as refresh tokens: whoever reads this table must not
/// be able to take over an account with what they find.
model VerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   VerificationPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ─── platform kernel ─────────────────────────────────────────────────────────
// Owned by the outbox module (write side, apps/api) and the outbox-relay module
// (read side, apps/worker). No domain lives here — this is the mechanism every
// bounded context uses to make a state change and its effects atomic.

enum OutboxStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  DEAD
}

/// A domain event, written in the SAME transaction as the state change that caused it.
/// That is the whole point: without the shared transaction you either lose effects (commit
/// state, crash before publishing) or invent them (publish, then roll back the state).
model OutboxMessage {
  id String @id @default(cuid())

  /// Stable across relay retries, so a consumer can dedupe on it. This is what turns
  /// at-least-once delivery into exactly-once *effects*.
  eventId       String       @unique
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)

  /// Retry bookkeeping. `availableAt` is moved forward on failure for exponential
  /// backoff, so a poisonous message cannot spin the relay.
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  publishedAt DateTime?
  lastError   String?

  /// W3C traceparent, captured at write time. This is what lets one trace span
  /// `POST /checkout -> outbox relay -> email sent` across the queue boundary.
  traceparent String?
  createdAt   DateTime @default(now())

  /// Serves the relay's claim query: pending work that is due, oldest first.
  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
}

/// Consumer-side dedupe. The relay guarantees at-least-once; this table is how a
/// handler makes its own effect happen exactly once. Keyed by (event, handler) so
/// each handler decides independently — a retry that already emailed must not email
/// again, but a handler added later must still see the event.
model ProcessedEvent {
  eventId     String
  handler     String
  processedAt DateTime @default(now())

  @@id([eventId, handler])
  @@index([processedAt])
}

enum IdempotencyStatus {
  IN_FLIGHT
  COMPLETED
}

/// Replay protection for unsafe endpoints. The client sends `Idempotency-Key`; a repeat
/// with the same key returns the stored response instead of acting twice.
model IdempotencyRecord {
  id String @id @default(cuid())

  /// Scoped per caller, never global. A globally-keyed table would let one user probe
  /// another user's stored response by guessing a key.
  scope String
  key   String

  endpoint    String
  /// A repeat of the same key with a DIFFERENT body is a client bug, not a retry,
  /// and is rejected rather than silently served the first response.
  requestHash String
  status      IdempotencyStatus @default(IN_FLIGHT)
  statusCode  Int?
  response    Json?
  createdAt   DateTime          @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

// ─── notification ────────────────────────────────────────────────────────────
// Owned by apps/worker/src/modules/notification (the send pipeline) and
// apps/api/src/modules/notification (preference centre, unsubscribe, bounce webhook).
// Split across two deployables for the same reason the outbox is: sending is a
// background effect with a poll-loop lifecycle, preferences are a request.

/// What a message is *about*. Preferences and unsubscribe operate on this, never on
/// individual templates — nobody wants a checkbox per email.
///
/// The mandatory/optional split is a product decision encoded in `MANDATORY_CATEGORIES`
/// (notification.service.ts), not in the database: a receipt or a password-reset link is
/// part of the transaction the user asked for, and offering to switch it off would be
/// dishonest. Everything else is opt-out.
enum NotificationCategory {
  /// Verification, reset links, password changed, new-device alerts. Mandatory.
  ACCOUNT_SECURITY
  /// Receipts, invoices, refunds, enrollment confirmations. Mandatory.
  PURCHASE
  /// Transcript ready, transcode failed, course published. Optional.
  COURSE_ACTIVITY
  /// Reviews, Q&A replies. Optional.
  ENGAGEMENT
  /// Announcements and product news. Optional.
  PRODUCT_NEWS
}

enum EmailDeliveryStatus {
  /// Claimed, provider call in flight. A row stuck here past the staleness window is
  /// a crashed sender and is retried.
  SENDING
  SENT
  /// The provider rejected it. The outbox retries the handler, which retries this row.
  FAILED
  /// Deliberately not sent: the address is suppressed, or the user opted out.
  SUPPRESSED
  /// Set by the provider webhook, after the fact.
  BOUNCED
  COMPLAINED
}

/// One attempt to email one person about one event.
///
/// `(eventId, template, recipient)` is unique, and that uniqueness *is* the idempotency
/// guarantee: the outbox delivers at-least-once, so the same event will be handled twice,
/// and the second attempt loses the insert race and sends nothing. This is the row that
/// makes "relay it twice, still one email" true.
model EmailDelivery {
  id String @id @default(cuid())

  /// The outbox event that caused this send.
  eventId   String
  template  String
  recipient String

  userId   String?
  category NotificationCategory
  subject  String

  status            EmailDeliveryStatus @default(SENDING)
  /// The provider's id for the message. It is how a later bounce webhook finds this row.
  providerMessageId String?
  attempts          Int                 @default(1)
  /// Provider error, or the reason a send was suppressed. One column because a human
  /// reading the delivery log wants one answer to "why didn't this arrive?".
  detail            String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([eventId, template, recipient])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

enum SuppressionReason {
  /// The mailbox does not exist. Continuing to send to it is what destroys sender
  /// reputation, which is why this outranks even mandatory categories.
  HARD_BOUNCE
  /// The recipient pressed "this is spam".
  COMPLAINT
  MANUAL
}

/// Addresses we must not email again, for any reason, until a human clears them.
///
/// Separate from `NotificationPreference` on purpose: a preference is a choice about a
/// category, a suppression is a fact about an address. Conflating them means a hard
/// bounce silently reads as "opted out of marketing" and the receipt still goes out.
model EmailSuppression {
  email     String            @id
  reason    SuppressionReason
  detail    String?
  createdAt DateTime          @default(now())
}

/// A user's opt-out for one optional category. Absent row = subscribed, so a new user
/// needs no rows written at signup and a new category defaults to on.
model NotificationPreference {
  userId   String
  category NotificationCategory
  enabled  Boolean

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

// ─── catalog ─────────────────────────────────────────────────────────────────
// Owned by apps/api/src/modules/catalog. This block is the shape of a course and
// the read path that serves the public list. The draft state machine, the publish
// gate and optimistic-concurrency autosave arrive with task 1.5 and operate on it.

/// Where a course is in its life — not what a viewer may see. Visibility is a
/// Specification (`visibleTo`), because an instructor sees their own DRAFT and an
/// anonymous visitor does not, and that is a rule about the *viewer*.
enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

/// A closed set rather than a free ISO-4217 string. An unconstrained string invites
/// `inr` and `INR` in the same column with no cheap way to notice. Adding a currency
/// is a migration, which is correct: it is a business decision, not a typo.
enum Currency {
  INR
  USD
}

/// ARTICLE exists because a text lecture needs no media pipeline and the entitlement
/// engine treats it identically. QUIZ is deliberately absent until there is a quiz.
enum LectureKind {
  VIDEO
  ARTICLE
}

/// Two levels, by convention rather than a CHECK: a top-level category has no parent,
/// a subcategory has one and no children of its own. Deeper nesting turns the browse
/// query into a recursive CTE for no user-visible gain.
model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the browse sidebar: the whole tree in two queries, roots then children.
  @@index([parentId])
}

/// The catalog aggregate root.
///
/// Sections and lectures are *inside* this aggregate — they have no independent
/// lifecycle and are never fetched without their course. That is why there is no
/// SectionRepository: a repository per table is how a domain goes anemic, and it would
/// let a caller write a lecture without updating its course's rollup counters.
model Course {
  id String @id @default(cuid())

  /// The public URL. Generated once from the title with a random suffix and never
  /// regenerated on rename: a published URL that changes is a broken link and a lost
  /// search ranking.
  slug String @unique

  title       String
  subtitle    String?
  description String      @db.Text
  /// BCP-47. A facet, not a locale — it says what language the lectures are in.
  language    String      @default("en")
  level       CourseLevel @default(ALL_LEVELS)

  status      CourseStatus @default(DRAFT)
  /// Set on the first publish and kept across unpublish/republish, because it is the
  /// catalog's sort key and a republished course jumping to the top of "newest" is a bug.
  publishedAt DateTime?

  /// Money in MINOR units — paise for INR, cents for USD. Never a float, never a decimal
  /// of rupees. Razorpay's API takes integer paise, so this is the representation that
  /// needs no conversion at the one boundary where a rounding error becomes a chargeback.
  /// `Int`, not `BigInt`: 2,147,483,647 paise is about ₹21 crore for a single course, and
  /// BigInt would serialize as a JSON string through BigIntSerializerInterceptor for
  /// nothing.
  priceMinor     Int      @default(0)
  /// The struck-through "was" price. Nullable because most courses have never been
  /// discounted, and 0 would be a lie the UI has to special-case.
  listPriceMinor Int?
  currency       Currency @default(INR)

  /// Object keys, not URLs. A URL embeds the CDN host, which changes; a key does not.
  thumbnailKey      String?
  /// Media's asset id (task 1.6). A plain string rather than a relation, because media
  /// owns that lifecycle and a duplicated course deliberately SHARES the value.
  promoVideoAssetId String?

  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Loose facets not worth a table: "kubernetes", "sre". Filtering is a `hasSome`.
  topics     String[]  @default([])

  /// Denormalized, written by `engagement` (task 1.14) inside the review transaction and
  /// only ever READ here. The force is the list query: an AVG over a reviews table on
  /// every catalog page is a join and a sort no index can rescue at 10k courses.
  /// Task 1.14 owes a reconciliation job that proves these never drift.
  ratingCount     Int     @default(0)
  ratingSum       Int     @default(0)
  ratingAverage   Decimal @default(0) @db.Decimal(3, 2)
  /// Written by `enrollment` (task 1.10). Same force, same read-only rule.
  enrollmentCount Int     @default(0)

  /// Rolled up at write time so a card can say "42 lectures · 6h 10m" without touching
  /// two more tables.
  lectureCount         Int @default(0)
  totalDurationSeconds Int @default(0)

  /// Optimistic-concurrency counter, owned by task 1.5's autosave (409 on a mismatch).
  /// The column lands now because adding it later is a second migration over a table
  /// that by then has real rows.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]

  // Every index below is justified by a measured before/after on 10,000 seeded courses in
  // `docs/db/indexes.md`. They land in their own migration, after the tables, so the
  // "before" column is a real measurement of a real point in this schema's history rather
  // than a simulation produced by turning `enable_indexscan` off.

  // `(status, priceMinor)` was measured and REJECTED: a 16.9%-selective facet is not an
  // index, and it was never chosen while the first index above exists. See indexes.md §7.

  /// The default catalog list and every keyset page of it — 7.838 ms -> 0.105 ms, and the
  /// `Sort` node disappears entirely. `id` is in the key because `publishedAt` is not
  /// unique, and a paginated sort on a non-unique key duplicates and skips rows.
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  /// Category browse, hot and cold alike — 4.7 ms -> 0.27 ms. `id` trails `publishedAt`
  /// so the plan has no Incremental Sort left to do.
  @@index([status, categoryId, publishedAt(sort: Desc), id(sort: Desc)])
  /// "Highest rated" — 6.814 ms -> 0.102 ms. Indexable only because `ratingAverage` is
  /// denormalised; an AVG over a reviews table could not be.
  @@index([status, ratingAverage(sort: Desc), id(sort: Desc)])
  /// Instructor dashboard — 4.424 ms -> 0.108 ms. Deliberately **no** `status` column:
  /// the default tab does not filter by one, and putting it between the equality key and
  /// the sort key costs the ordering and re-introduces an unbounded sort.
  @@index([instructorId, updatedAt(sort: Desc)])
  /// Interim substring search until Typesense (task 1.13) — 9.833 ms -> 0.813 ms on the
  /// trigram path. Replaced by a search engine, at which point this index is dropped.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// A chapter. Ordered by `position` with gaps of 10, so inserting between two sections
/// is one UPDATE rather than a renumber of the whole course.
model Section {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title    String
  position Int

  lectures Lecture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The invariant lives in the database, not in a service: a table that permits two
  /// sections at position 3 will eventually contain two sections at position 3.
  /// Reordering therefore runs two passes in one transaction (shift negative, then
  /// settle) — Postgres checks uniqueness per statement and Prisma cannot declare
  /// DEFERRABLE. Task 1.5 implements it; 1.4 only bulk-inserts.
  @@unique([courseId, position])
  /// Serves the detail page: one course's sections, in order.
  @@index([courseId, position])
}

model Lecture {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title       String
  description String?     @db.Text
  kind        LectureKind @default(VIDEO)
  position    Int

  /// The free-preview flag. Read by the entitlement engine (task 1.8) as the rule that
  /// turns ABSTAIN into ALLOW for someone who has bought nothing.
  isPreview Boolean @default(false)

  durationSeconds Int     @default(0)
  /// Media's asset id (task 1.6). A string, not a relation: media owns that lifecycle,
  /// and duplicating a course shares this value rather than copying gigabytes.
  assetId         String?
  articleBody     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, position])
  @@index([sectionId, position])
}
