# ---- API ----
NODE_ENV=development
API_PORT=3001
# When running the api in docker-compose, host is the service name "postgres" / "redis" / "minio".
# When running on the host against compose infra, use localhost.
DATABASE_URL=postgresql://masternova:masternova@localhost:5432/masternova?schema=public
REDIS_URL=redis://localhost:6379
COOKIE_SECRET=dev-cookie-secret-change-me-32-chars-min
JWT_ACCESS_SECRET=dev-jwt-secret-change-me-at-least-32-chars

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT=http://localhost:9000
# Endpoint signed into presigned URLs the BROWSER uses. On the host this matches
# S3_ENDPOINT; inside docker-compose the api uses http://minio:9000 internally but
# signs http://localhost:9000 so the browser can reach it.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=masternova-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Google OAuth (optional) ----
# Leave blank to disable Google sign-in. To enable: create OAuth credentials in Google
# Cloud Console, set the authorized redirect URI to GOOGLE_CALLBACK_URL below, then also
# set NEXT_PUBLIC_GOOGLE_ENABLED=1 for the web app to show the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# NEXT_PUBLIC_GOOGLE_ENABLED=1

# ---- Notification / mail (task 1.3) ----
# Which MailProvider adapter binds. `smtp` covers Mailpit locally and SES in production;
# `resend` is the HTTP API. Chosen explicitly rather than inferred from NODE_ENV, so
# staging can point at the real provider without pretending to be production.
MAIL_PROVIDER=smtp
MAIL_FROM="Masternova <no-reply@masternova.in>"
# MAIL_REPLY_TO=support@masternova.in

# Mailpit speaks plain SMTP on 1025 and shows every message at http://localhost:8025.
# SES wants STARTTLS on 587 with SMTP_SECURE=false, or 465 with SMTP_SECURE=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Only read when MAIL_PROVIDER=resend.
# RESEND_API_KEY=

# Every link in an email is built from these, so a wrong value ships a localhost URL to a
# real inbox. WEB_URL is where a human lands; API_PUBLIC_URL is what a mail provider POSTs
# for RFC 8058 one-click unsubscribe, so it must be reachable from outside the network.
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# HMAC key for unsubscribe links. The worker signs, the API verifies — they must match
# byte for byte. Rotating it invalidates every outstanding link, which is the entire
# revocation story for a stateless token.
UNSUBSCRIBE_SECRET=dev-unsubscribe-secret-change-me-32-chars

# --- entitlement (task 1.8) ---
# Signs playback tokens. Its own secret, not JWT_ACCESS_SECRET: a leak here mints
# five-minute grants for one lecture, a leak there mints sessions.
PLAYBACK_TOKEN_SECRET=dev-playback-secret-change-me-32-chars-long
PLAYBACK_TOKEN_TTL_SECONDS=300
# Bind the token to the caller's address. On in production; off locally, where a laptop,
# a container and a proxy present three different addresses for the same user.
PLAYBACK_TOKEN_BIND_IP=false
# Believe X-Forwarded-For. Only ever true behind a proxy we control — trusting the header
# when nothing strips it lets any client claim any address. PLAYBACK_TOKEN_BIND_IP is a
# no-op without this behind a load balancer: request.ip would be the balancer, for everyone.
TRUST_PROXY=false

# Provider webhook signing secret (bounces and complaints). When it is absent the webhook
# rejects every request rather than trusting the caller — unverified is not unconfigured.
# MAIL_WEBHOOK_SECRET=

# ---- Web ----
# Where the Next.js dev server proxies /api and /socket. Service name "api" inside compose.
API_URL=http://localhost:3001
