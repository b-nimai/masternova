# ---- API ----
NODE_ENV=development
API_PORT=3001
# When running the api in docker-compose, host is the service name "postgres" / "redis" / "minio".
# When running on the host against compose infra, use localhost.
DATABASE_URL=postgresql://masternova:masternova@localhost:5432/masternova?schema=public
REDIS_URL=redis://localhost:6379
COOKIE_SECRET=dev-cookie-secret-change-me-32-chars-min
JWT_ACCESS_SECRET=dev-jwt-secret-change-me-at-least-32-chars

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT=http://localhost:9000
# Endpoint signed into presigned URLs the BROWSER uses. On the host this matches
# S3_ENDPOINT; inside docker-compose the api uses http://minio:9000 internally but
# signs http://localhost:9000 so the browser can reach it.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=masternova-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Google OAuth (optional) ----
# Leave blank to disable Google sign-in. To enable: create OAuth credentials in Google
# Cloud Console, set the authorized redirect URI to GOOGLE_CALLBACK_URL below, then also
# set NEXT_PUBLIC_GOOGLE_ENABLED=1 for the web app to show the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# NEXT_PUBLIC_GOOGLE_ENABLED=1

# ---- Mail (Mailpit in dev) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Masternova <no-reply@masternova.in>"

# ---- Web ----
# Where the Next.js dev server proxies /api and /socket. Service name "api" inside compose.
API_URL=http://localhost:3001
