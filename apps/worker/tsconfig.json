{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Same NestJS CommonJS override as apps/api; strictness is inherited from the base.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    // Email templates are typed React components rendered to HTML by @react-email/render
    // (task 1.3). The automatic runtime means templates never import React just to satisfy
    // the compiler.
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "."
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
