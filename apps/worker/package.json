{
  "name": "@masternova/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "pnpm test:unit && pnpm test:int",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.unit.config.js",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.int.config.js --runInBand"
  },
  "dependencies": {
    "@masternova/contracts": "workspace:*",
    "@masternova/db": "workspace:*",
    "@masternova/shared": "workspace:*",
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@react-email/render": "^2.1.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.6",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "jest": "^29.7.0",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
