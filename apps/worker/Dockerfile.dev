# Dev image for the BullMQ worker. Build context is the repo ROOT.
FROM node:24-slim

RUN apt-get update && apt-get install -y --no-install-recommends openssl python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile=false

# The worker persists job results, so it needs the generated client too.
RUN pnpm --filter @masternova/db run generate

WORKDIR /app/apps/worker
CMD ["pnpm", "dev"]
